# ============================================
# ShopMax Backend - Configuration
# Copiez ce fichier vers .env et remplissez
# ============================================

# Application
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Database (PostgreSQL)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=shopmax;Username=postgres;Password=VOTRE_MOT_DE_PASSE

# JWT Authentication
JwtSettings__Secret=VOTRE_CLE_SECRETE_32_CARACTERES_MIN
JwtSettings__Issuer=ShopMax
JwtSettings__Audience=ShopMaxUsers
JwtSettings__ExpirationInMinutes=10080

# Google OAuth (optionnel)
GoogleAuth__ClientId=VOTRE_CLIENT_ID.apps.googleusercontent.com
GoogleAuth__ClientSecret=VOTRE_CLIENT_SECRET
GoogleAuth__RedirectUrl=http://localhost:5000/api/auth/google/callback

# Facebook OAuth (optionnel)
FacebookAuth__AppId=VOTRE_APP_ID
FacebookAuth__AppSecret=VOTRE_APP_SECRET

# Resend (email)
Resend__ApiKey=re_VOTRE_CLE_API
Resend__FromEmail=noreply@votredomaine.com

# NotchPay (paiement)
NotchPay__PublicKey=VOTRE_CLE_PUBLIQUE
NotchPay__SecretKey=VOTRE_CLE_SECRETE
NotchPay__Environment=sandbox

# Redis (optionnel)
ConnectionStrings__Redis=localhost:6379

# CORS
CorsSettings__AllowedOrigins=http://localhost:3000
