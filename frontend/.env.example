# ============================================
# ShopMax Frontend - Configuration
# Copiez ce fichier vers .env.local
# ============================================

# API Backend (URL de votre backend ASP.NET)
# En local : http://localhost:5000/api
# Sur Vercel : laissez vide pour utiliser le mock fallback
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# URL publique du site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (optionnel - desactive pour le moment)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Analytics (optionnel)
NEXT_PUBLIC_GA_ID=

# Desactive la verification SSL en dev (utile pour backend local)
NEXT_PUBLIC_INSECURE_SSL=false
